---
/**
 * The home page, rendered once per language.
 *
 * The markup lives here, not in the route files, so `/` and `/es/` cannot drift
 * structurally: there is exactly one template and two thin route wrappers. A
 * section that exists in Spanish but not in English is impossible by
 * construction, and every string comes from a `Localized<T>` object that fails
 * `astro check` if a language is missing.
 */
import Layout from "../../layouts/Layout.astro";
import { caseStudies } from "../../data/caseStudies";
import { stats } from "../../data/experience";
import { ui } from "../../data/ui";
import { localizedPath, t, type Locale } from "../../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const cvHref =
  lang === "es"
    ? "/marius-mihail-ion-cv-es.pdf"
    : "/marius-mihail-ion-cv.pdf";
---

<Layout
  title={t(ui.homeTitle, lang)}
  description={t(ui.homeDescription, lang)}
  ogTitle={t(ui.homeOgTitle, lang)}
  ogDescription={t(ui.homeOgDescription, lang)}
  includePersonSchema
>
  <section class="hero">
    <div class="wrap hero__grid">
      <!-- The hero's own composition is a small spatial deck: the portrait
           card on top of two fanned outcome cards, in real 3D (perspective +
           preserve-3d), the same technique the Work section uses at full
           scale below. The idea has to read in the first viewport, not only
           after scrolling to Work. -->
      <div class="hero__deck">
        {
          stats.slice(0, 2).map((stat, i) => (
            <div class="hero__card hero__card--stat" style={`--i:${i}`} aria-hidden="true">
              <p class="hero__card-value">{t(stat.value, lang)}</p>
              <p class="hero__card-label">{t(stat.label, lang)}</p>
            </div>
          ))
        }
        <figure class="hero__card hero__card--photo">
          <img
            class="hero__photo"
            src="/me.webp"
            alt={t(ui.heroPhotoAlt, lang)}
            width="640"
            height="640"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>

      <div class="hero__body">
        <h1 class="hero__title">{t(ui.heroTitle, lang)}</h1>
        <p class="hero__role">{t(ui.siteRole, lang)}</p>
        <p class="hero__lede">{t(ui.heroLede, lang)}</p>
        <div class="hero__actions">
          <a class="btn btn-primary" href={localizedPath("/case-studies/", lang)}>
            {t(ui.heroCtaCases, lang)}
          </a>
          <a class="btn" href={cvHref} download>
            {t(ui.heroCtaCv, lang)}
          </a>
          <a class="btn" href="https://linkedin.com/in/mariusdev">LinkedIn</a>
          <a class="btn" href="https://github.com/mihailmariusiondev">GitHub</a>
        </div>
        <p class="hero__location">{t(ui.heroLocation, lang)}</p>
      </div>
    </div>
  </section>

  <section class="stats" aria-labelledby="stats-heading">
    <div class="wrap">
      <h2 id="stats-heading" class="stats__heading eyebrow">
        {t(ui.statsHeading, lang)}
      </h2>
      <ul class="stats__list">
        {
          stats.map((stat) => (
            <li class="stat">
              <p class="stat__value">{t(stat.value, lang)}</p>
              <p class="stat__label">{t(stat.label, lang)}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="work" class="deck-section" aria-labelledby="work-heading">
    <div class="wrap deck-section__head">
      <h2 id="work-heading" class="deck-section__title">{t(ui.workTitle, lang)}</h2>
      <p class="deck-section__lede prose">{t(ui.workLede, lang)}</p>
    </div>

    <div class="deck-scroller">
      <div class="deck-viewport">
        <ol class="deck-stage" aria-label={t(ui.casesAriaLabel, lang)}>
          {
            caseStudies.map((study, i) => {
              const href = localizedPath(`/case-studies/${study.slug}/`, lang);
              return (
                <li class="plane" style={`--i:${i}`}>
                  <a
                    class="plane__face"
                    href={href}
                    style={`view-transition-name: case-${study.slug}`}
                  >
                    <span class="plane__badge">{t(study.badge, lang)}</span>
                    <h3 class="plane__title">{t(study.title, lang)}</h3>
                    <p class="plane__summary">{t(study.summary, lang)}</p>
                    <ul
                      class="plane__tags tag-row"
                      aria-label={t(ui.tagsLabel, lang)}
                    >
                      {study.tags.slice(0, 3).map((tag) => (
                        <li class="tag">{t(tag, lang)}</li>
                      ))}
                    </ul>
                    <span class="plane__cue" aria-hidden="true">
                      {t(ui.cardCue, lang)} &rarr;
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ol>
      </div>
    </div>

    <div class="wrap deck-section__foot">
      <p class="deck-section__hint">{t(ui.deckHint, lang)}</p>
      <a class="btn" href={localizedPath("/case-studies/", lang)}>
        {t(ui.caseNavAll, lang)} &rarr;
      </a>
    </div>
  </section>
</Layout>

<style>
  /* ---------------- Hero ---------------- */

  .hero {
    padding-block: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--rule);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .hero__grid {
      /* Text first in the source order and in the visual order on desktop. */
      grid-template-columns: minmax(0, 1fr) 14rem;
      gap: var(--space-5);
    }
    .hero__deck {
      order: 2;
    }
    .hero__body {
      order: 1;
    }
  }

  /* ---------------- Hero deck: the spatial idea, first paint ----------------
     The portrait card floats in front of two "outcome" cards, fanned behind
     it in real 3D (perspective + preserve-3d), the same technique as the
     Work section below at a smaller scale. This is deliberately what a
     visitor sees before scrolling a pixel: the composition itself, not just
     an accent colour, carries the "Spatial Deck" idea above the fold. */

  .hero__deck {
    position: relative;
    margin: 0;
    aspect-ratio: 1 / 1;
    /* On mobile the deck is centred above the text, not floated beside it. */
    justify-self: center;
    width: min(11rem, 45vw);
    perspective: 900px;
    perspective-origin: 50% 30%;
    transform-style: preserve-3d;
  }

  @media (min-width: 56rem) {
    .hero__deck {
      justify-self: end;
      width: 100%;
      max-width: 14rem;
      perspective: 1100px;
    }
  }

  .hero__card {
    position: absolute;
    inset: 0;
  }

  .hero__card--photo {
    /* Front of the stack: sits at the deck's resting depth (z: 0), so real
       3D depth-sorting (enabled by --preserve-3d on the parent) keeps it
       painted above the two outcome cards regardless of source order. */
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    box-shadow: var(--shadow-raised);
  }

  .hero__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The head sits in the upper third of the 640x640 source. Raise the crop
       to it, but not so far that the top of the head is cut. */
    object-position: 50% 22%;
  }

  .hero__card--stat {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.8rem 0.9rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: var(--deck-shadow);
    /* Fanned behind the photo: pushed left/right and up/down, and back in Z
       (negative = further from the camera), so the photo card in front
       always reads as the top of the stack. */
    --settle: translate3d(
        calc((var(--i) - 0.5) * 28%),
        calc((var(--i) - 0.5) * 24%),
        calc((var(--i) + 1) * -52px)
      )
      rotateY(calc((var(--i) - 0.5) * -9deg))
      rotateZ(calc((var(--i) - 0.5) * 7deg));
    transform: var(--settle);
    animation: hero-card-settle 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 110ms + 150ms);
  }

  .hero__card-value {
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--steel-dark);
  }

  .hero__card-label {
    font-size: 0.6875rem;
    line-height: 1.35;
    color: var(--slate);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  @keyframes hero-card-settle {
    from {
      opacity: 0;
      transform: translate3d(0, 22px, -22px) rotateY(0deg) rotateZ(0deg);
    }
    to {
      opacity: 1;
      transform: var(--settle);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__card--stat {
      animation: none;
      transform: var(--settle);
      opacity: 1;
    }
  }

  .hero__title {
    font-size: var(--step-display);
    max-width: 20ch;
    margin-block: 0 var(--space-1);
  }

  .hero__role {
    font-family: var(--font-mono);
    font-size: var(--step-small);
    letter-spacing: 0.02em;
    color: var(--steel-dark);
    margin-bottom: var(--space-3);
  }

  .hero__lede {
    max-width: 54ch;
    font-size: var(--step-lede);
    color: var(--slate);
    margin-bottom: var(--space-3);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: var(--space-3);
  }

  .hero__location {
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    line-height: 1.6;
    color: var(--slate-quiet);
    max-width: 48ch;
  }

  /* ---------------- Verified results ---------------- */

  .stats {
    padding-block: var(--space-4);
    background: var(--paper-sunk);
    border-bottom: 1px solid var(--rule);
  }

  .stats__heading {
    margin-bottom: var(--space-3);
  }

  .stats__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 40rem) {
    .stats__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3) var(--space-4);
    }
  }

  @media (min-width: 64rem) {
    .stats__list {
      /* The five figures read as one measured ledger, not five loose cards. */
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .stat {
    /* The rule is the signature: each figure is an audited entry, not a badge. */
    border-left: 2px solid var(--steel);
    padding-left: var(--space-2);
    min-width: 0;
  }

  .stat__value {
    font-family: var(--font-mono);
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--steel-dark);
    margin-bottom: 0.4rem;
    overflow-wrap: break-word;
  }

  .stat__label {
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--slate);
    max-width: 40ch;
  }

  /* ---------------- Case studies: the spatial deck ----------------
     Four planes stacked in real 3D (perspective + preserve-3d). They fan out
     and settle on load, a scroll-linked camera dollies through the stack as
     the section passes, and hover/focus lifts a plane flat toward the
     viewer. The whole system is CSS: no JS ships for any of it. */

  .deck-section {
    padding-block: var(--space-5) var(--space-4);
  }

  .deck-section__head {
    margin-bottom: var(--space-4);
  }

  .deck-section__title {
    font-size: var(--step-h2);
    margin-bottom: var(--space-1);
  }

  .deck-section__lede {
    color: var(--slate);
  }

  .deck-scroller {
    position: relative;
  }

  /* A plain flow block, not a scroll-hijacked sticky viewport: an earlier
     version pinned this with `position: sticky` and 260vh of extra scroll
     room for a scroll-linked "camera" pass, driven by
     `animation-timeline: view()`. That combination reserves real document
     height that is only ever filled while an actual user is mid-scroll, so
     any tool that renders/captures the page without simulating scroll
     (full-page screenshot, some Lighthouse/headless capture paths) shows a
     large blank gap where the pinned section briefly showed. Removed in
     favour of the same fan + hover-lift composition Work already had,
     always laid out normally: no reserved height, nothing to render wrong
     when nobody is scrolling. */
  .deck-viewport {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: var(--space-4);
    perspective: var(--deck-perspective);
    perspective-origin: 50% 42%;
  }

  .deck-stage {
    list-style: none;
    position: relative;
    margin: 0;
    padding: 0;
    width: min(90vw, 34rem);
    height: 24rem;
    transform-style: preserve-3d;
  }

  .plane {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    /* Resting fan position per plane, read by the settle keyframes below. */
    --settle: translate3d(
        calc((var(--i) - 1.5) * 34px),
        calc(var(--i) * -10px),
        calc(var(--i) * -110px)
      )
      rotateY(calc((var(--i) - 1.5) * -7deg)) rotateX(3deg);
    transform: var(--settle);
    animation: plane-settle 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 90ms);
  }

  @keyframes plane-settle {
    from {
      transform: translate3d(0, 40px, -40px) rotateY(0deg) rotateX(8deg);
      opacity: 0;
    }
    to {
      transform: var(--settle);
      opacity: 1;
    }
  }

  .plane__face {
    display: flex;
    flex-direction: column;
    position: absolute;
    inset: 0;
    padding: var(--space-3);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 14px;
    box-shadow: var(--deck-shadow);
    text-decoration: none;
    color: var(--ink);
    backface-visibility: hidden;
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 300ms ease;
  }

  /* Hover or focus tilts the picked plane flat, toward the viewer, and lifts
     it above its neighbours: picking a card up off the deck. */
  .plane__face:hover,
  .plane__face:focus-visible {
    transform: translate3d(0, -14px, 140px) rotateY(0deg) rotateX(0deg);
    box-shadow: var(--deck-shadow-hover);
    z-index: 5;
  }

  .plane__badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    letter-spacing: 0.02em;
    color: var(--steel-dark);
    background: var(--steel-wash);
    border-radius: 3px;
    padding: 0.25em 0.6em;
    margin-bottom: var(--space-2);
  }

  .plane__title {
    font-size: var(--step-h3);
    margin-bottom: 0.5rem;
  }

  .plane__summary {
    color: var(--slate);
    margin-bottom: var(--space-2);
    flex: 1 1 auto;
    /* Long summaries stay legible on the fixed-height plane. */
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
  }

  .plane__tags {
    margin-bottom: var(--space-2);
  }

  .plane__cue {
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    color: var(--steel-dark);
  }

  .deck-section__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .deck-section__hint {
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    color: var(--slate-quiet);
  }

  /* ---------------- Mobile: lighter depth, no overlapping targets ----------
     A shallow, non-scroll-hijacked stack. Each plane is its own full-width
     tap target; only a soft shadow offset carries the depth, so nothing sits
     under another plane's touch area. */
  @media (max-width: 47.999rem) {
    .deck-viewport {
      display: block;
      padding-block: 0;
      perspective: 900px;
    }

    .deck-stage {
      display: grid;
      gap: var(--space-3);
      width: 100%;
      height: auto;
    }

    .plane {
      position: static;
      --settle: translate3d(0, 0, 0) rotateY(0deg) rotateX(0deg);
      animation: plane-settle-mobile 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--i) * 80ms);
    }

    @keyframes plane-settle-mobile {
      from {
        transform: translateY(18px) rotateX(6deg);
        opacity: 0;
      }
      to {
        transform: translateY(0) rotateX(0deg);
        opacity: 1;
      }
    }

    .plane__face {
      position: static;
      min-height: 15rem;
    }

    .plane__face:hover,
    .plane__face:focus-visible {
      transform: translateY(-4px) translateZ(30px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .deck-stage,
    .plane,
    .plane__face {
      animation: none !important;
      transition: none !important;
    }

    .plane {
      transform: var(--settle);
      opacity: 1;
    }

    .plane__face:hover,
    .plane__face:focus-visible {
      transform: translateZ(20px);
    }
  }
</style>

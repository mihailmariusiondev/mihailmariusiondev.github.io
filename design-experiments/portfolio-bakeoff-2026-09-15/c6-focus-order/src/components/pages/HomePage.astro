---
/**
 * The home page, rendered once per language.
 *
 * The markup lives here, not in the route files, so `/` and `/es/` cannot drift
 * structurally: there is exactly one template and two thin route wrappers. A
 * section that exists in Spanish but not in English is impossible by
 * construction, and every string comes from a `Localized<T>` object that fails
 * `astro check` if a language is missing.
 */
import Layout from "../../layouts/Layout.astro";
import CaseStudyCard from "../CaseStudyCard.astro";
import { caseStudies } from "../../data/caseStudies";
import { stats } from "../../data/experience";
import { ui } from "../../data/ui";
import { NAV_ITEMS } from "../../data/ui";
import { localizedPath, t, type Locale } from "../../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const cvHref =
  lang === "es"
    ? "/marius-mihail-ion-cv-es.pdf"
    : "/marius-mihail-ion-cv.pdf";
const contactItem = NAV_ITEMS.find((item) => item.icon === "contact")!;
---

<Layout
  title={t(ui.homeTitle, lang)}
  description={t(ui.homeDescription, lang)}
  ogTitle={t(ui.homeOgTitle, lang)}
  ogDescription={t(ui.homeOgDescription, lang)}
  includePersonSchema
>
  <div class="focus-sweep" aria-hidden="true"></div>

  <section class="hero">
    <div class="wrap hero__grid">
      <figure class="hero__figure">
        <img
          class="hero__photo"
          src="/me.webp"
          alt={t(ui.heroPhotoAlt, lang)}
          width="640"
          height="640"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <div class="hero__body">
        <p class="eyebrow" data-focus-stop="role">{t(ui.siteRole, lang)}</p>
        <h1 class="hero__title">{t(ui.heroTitle, lang)}</h1>
        <p class="hero__lede">{t(ui.heroLede, lang)}</p>
        <div class="hero__actions">
          <a class="btn btn-primary" href={localizedPath("/case-studies/", lang)}>
            {t(ui.heroCtaCases, lang)}
          </a>
          <a class="btn" href={cvHref} download data-focus-stop="cv">
            {t(ui.heroCtaCv, lang)}
          </a>
          <a
            class="btn"
            href={localizedPath(contactItem.href, lang)}
            data-focus-stop="contact"
          >
            {t(contactItem.label, lang)}
          </a>
          <a class="btn" href="https://linkedin.com/in/mariusdev">LinkedIn</a>
          <a class="btn" href="https://github.com/mihailmariusiondev">GitHub</a>
        </div>
        <p class="hero__location">{t(ui.heroLocation, lang)}</p>
      </div>
    </div>
  </section>

  <section class="stats" aria-labelledby="stats-heading">
    <div class="wrap">
      <h2 id="stats-heading" class="stats__heading eyebrow">
        {t(ui.statsHeading, lang)}
      </h2>
      <ul class="stats__list" data-focus-stop="outcomes">
        {
          stats.map((stat, i) => (
            <li class="stat" style={`--i: ${i}`}>
              <p class="stat__value">{t(stat.value, lang)}</p>
              <p class="stat__label">{t(stat.label, lang)}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="work" class="work">
    <div class="wrap">
      <div class="work__head">
        <h2 class="work__title">{t(ui.workTitle, lang)}</h2>
        <p class="work__lede prose">{t(ui.workLede, lang)}</p>
      </div>
      <div class="work__grid">
        {caseStudies.map((study) => <CaseStudyCard study={study} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------------- Hero ---------------- */

  .hero {
    padding-block: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--rule);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .hero__grid {
      /* Text first in the source order and in the visual order on desktop. */
      grid-template-columns: minmax(0, 1fr) 14rem;
      gap: var(--space-5);
    }
    .hero__figure {
      order: 2;
    }
    .hero__body {
      order: 1;
    }
  }

  .hero__figure {
    margin: 0;
    /* On mobile the portrait is centred above the text, not floated beside it. */
    justify-self: center;
    width: min(11rem, 45vw);
  }

  @media (min-width: 56rem) {
    .hero__figure {
      justify-self: end;
      width: 100%;
      max-width: 14rem;
    }
  }

  .hero__photo {
    display: block;
    width: 100%;
    /* height:auto is load-bearing. The img carries width/height attributes (for
       CLS), and aspect-ratio is ignored unless the other axis is auto: without
       this the picture renders 176x640. */
    height: auto;
    /* Square frame. The source is a standing shot: a circle crops to the
       forearms and a 4:5 frame towers over the text column. */
    aspect-ratio: 1 / 1;
    object-fit: cover;
    /* The head sits in the upper third of the 640x640 source. Raise the crop
       to it, but not so far that the top of the head is cut. */
    object-position: 50% 22%;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    box-shadow: var(--shadow-raised);
  }

  .hero__title {
    font-size: var(--step-display);
    max-width: 20ch;
    margin-block: var(--space-2) var(--space-3);
  }

  .hero__lede {
    max-width: 54ch;
    font-size: var(--step-lede);
    color: var(--slate);
    margin-bottom: var(--space-3);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: var(--space-3);
  }

  .hero__location {
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    line-height: 1.6;
    color: var(--slate-quiet);
    max-width: 48ch;
  }

  /* ---------------- Verified results ---------------- */

  .stats {
    padding-block: var(--space-4);
    background: var(--paper-sunk);
    border-bottom: 1px solid var(--rule);
  }

  .stats__heading {
    margin-bottom: var(--space-3);
  }

  .stats__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 40rem) {
    .stats__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3) var(--space-4);
    }
  }

  @media (min-width: 64rem) {
    .stats__list {
      /* The five figures read as one measured ledger, not five loose cards. */
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .stat {
    /* The rule is the signature: each figure is an audited entry, not a badge.
       It draws in top-to-bottom on first paint, staggered per item: one
       authored moment, not five identical entrances at once. */
    border-left: 2px solid var(--steel);
    padding-left: var(--space-2);
    min-width: 0;
    animation: stat-rule 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    animation-delay: calc(var(--i, 0) * 90ms + 120ms);
  }

  @keyframes stat-rule {
    from {
      border-left-color: transparent;
      opacity: 0;
      transform: translateX(-0.4rem);
    }
    to {
      border-left-color: var(--steel);
      opacity: 1;
      transform: none;
    }
  }

  .stat__value {
    font-family: var(--font-mono);
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--steel-dark);
    margin-bottom: 0.4rem;
    overflow-wrap: break-word;
  }

  .stat__label {
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--slate);
    max-width: 40ch;
  }

  /* ---------------- Case studies ---------------- */

  .work {
    padding-block: var(--space-5);
  }

  .work__head {
    margin-bottom: var(--space-4);
  }

  .work__title {
    font-size: var(--step-h2);
    margin-bottom: var(--space-1);
  }

  .work__lede {
    color: var(--slate);
  }

  .work__grid {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 56rem) {
    .work__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  /**
   * Hero focus sweep: a real focus ring (same object as :focus-visible in
   * global.css) visits the hero content in DOM/reading order once — name,
   * role, outcomes, CV, contact — then hands off to the keyboard.
   *
   * Progressive enhancement: every stop is already visible, readable content
   * without this script. Cancels immediately on any real keyboard, pointer
   * or wheel input, and never runs at all under prefers-reduced-motion or on
   * a repeat visit within the same tab session.
   */
  (function () {
    const ring = document.querySelector<HTMLElement>(".focus-sweep");
    if (!ring) return;

    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const played = sessionStorage.getItem("focus-sweep-played") === "1";

    if (reduce || played) {
      ring.remove();
      return;
    }

    const stops = Array.from(
      document.querySelectorAll<HTMLElement>("[data-focus-stop]"),
    );
    if (stops.length === 0) {
      ring.remove();
      return;
    }

    sessionStorage.setItem("focus-sweep-played", "1");

    let cancelled = false;
    let timer = 0;

    function place(el: HTMLElement) {
      const r = el.getBoundingClientRect();
      const pad = 8;
      ring!.style.width = `${r.width + pad * 2}px`;
      ring!.style.height = `${r.height + pad * 2}px`;
      ring!.style.transform = `translate(${r.left - pad}px, ${r.top - pad}px)`;
    }

    function cancel() {
      if (cancelled) return;
      cancelled = true;
      window.clearTimeout(timer);
      ring!.classList.remove("is-active");
      window.setTimeout(() => ring?.remove(), 260);
    }

    window.addEventListener("keydown", cancel, { once: true });
    window.addEventListener("pointerdown", cancel, { once: true });
    window.addEventListener("wheel", cancel, { once: true, passive: true });

    let idx = 0;
    function step() {
      if (cancelled) return;
      if (idx >= stops.length) {
        cancel();
        return;
      }
      place(stops[idx]);
      ring!.classList.add("is-active");
      idx += 1;
      timer = window.setTimeout(step, 560);
    }

    requestAnimationFrame(() => requestAnimationFrame(step));
  })();
</script>

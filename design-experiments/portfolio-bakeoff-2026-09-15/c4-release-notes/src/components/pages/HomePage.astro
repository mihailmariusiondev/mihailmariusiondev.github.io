---
/**
 * The home page, rendered once per language.
 *
 * The markup lives here, not in the route files, so `/` and `/es/` cannot drift
 * structurally: there is exactly one template and two thin route wrappers. A
 * section that exists in Spanish but not in English is impossible by
 * construction, and every string comes from a `Localized<T>` object that fails
 * `astro check` if a language is missing.
 */
import Layout from "../../layouts/Layout.astro";
import CaseStudyCard from "../CaseStudyCard.astro";
import { caseStudies } from "../../data/caseStudies";
import { stats } from "../../data/experience";
import { ui } from "../../data/ui";
import { localizedPath, t, type Locale } from "../../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const cvHref =
  lang === "es"
    ? "/marius-mihail-ion-cv-es.pdf"
    : "/marius-mihail-ion-cv.pdf";
---

<Layout
  title={t(ui.homeTitle, lang)}
  description={t(ui.homeDescription, lang)}
  ogTitle={t(ui.homeOgTitle, lang)}
  ogDescription={t(ui.homeOgDescription, lang)}
  includePersonSchema
>
  <section class="hero">
    <!--
      The rollout flag: a real, native checkbox. Checked by default, so the
      strongest outcomes are on screen with zero interaction (recruiter-scan
      requirement holds even with JS disabled — this whole mechanism is pure
      CSS `:has()`, never JS-gated). Flipping it off/on demonstrates the
      staged-reveal motion this concept is about.
    -->
    <input type="checkbox" id="rollout-flag" class="flag-input" checked />

    <div class="wrap hero__grid">
      <div class="hero__control">
        <label for="rollout-flag" class="flag">
          <span class="flag__track" aria-hidden="true">
            <span class="flag__thumb"></span>
          </span>
          <span class="flag__text">
            <code class="flag__name">{t(ui.heroFlagName, lang)}</code>
            <span class="flag__state flag__state--on">{t(ui.heroFlagStateOn, lang)}</span>
            <span class="flag__state flag__state--off">{t(ui.heroFlagStateOff, lang)}</span>
          </span>
        </label>
        <p class="flag__hint visually-hidden" id="rollout-flag-hint">
          {t(ui.heroFlagHint, lang)}
        </p>
      </div>

      <figure class="hero__figure">
        <img
          class="hero__photo"
          src="/me.webp"
          alt={t(ui.heroPhotoAlt, lang)}
          width="640"
          height="640"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <div class="hero__body">
        <p class="hero__release">
          <span class="hero__release-tag">release</span> marius-mihail-ion
        </p>
        <h1 class="hero__title">{t(ui.heroTitle, lang)}</h1>
        <p class="hero__lede">{t(ui.heroLede, lang)}</p>

        <div class="hero__outcomes-wrap">
          <ul class="hero__outcomes" aria-describedby="rollout-flag-hint">
            {
              stats.slice(0, 3).map((stat) => (
                <li class="outcome">
                  <span class="outcome__value">{t(stat.value, lang)}</span>
                  <span class="outcome__label">{t(stat.label, lang)}</span>
                </li>
              ))
            }
          </ul>
          <p class="hero__outcomes-off" aria-hidden="true">{t(ui.heroOutcomesOff, lang)}</p>
        </div>

        <div class="hero__actions">
          <a class="btn btn-primary" href={localizedPath("/case-studies/", lang)}>
            {t(ui.heroCtaCases, lang)}
          </a>
          <a class="btn" href={cvHref} download>
            {t(ui.heroCtaCv, lang)}
          </a>
          <a class="btn" href="https://linkedin.com/in/mariusdev">LinkedIn</a>
          <a class="btn" href="https://github.com/mihailmariusiondev">GitHub</a>
        </div>
        <p class="hero__location">{t(ui.heroLocation, lang)}</p>
      </div>
    </div>
  </section>

  <section class="stats" aria-labelledby="stats-heading">
    <div class="wrap">
      <h2 id="stats-heading" class="stats__heading mono-heading">
        {t(ui.statsHeading, lang)}
      </h2>
      <ul class="stats__list">
        {
          stats.map((stat) => (
            <li class="stat">
              <p class="stat__value">{t(stat.value, lang)}</p>
              <p class="stat__label">{t(stat.label, lang)}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="work" class="work">
    <div class="wrap">
      <div class="work__head">
        <h2 class="work__title">{t(ui.workTitle, lang)}</h2>
        <p class="work__lede prose">{t(ui.workLede, lang)}</p>
      </div>
      <div class="work__grid">
        {caseStudies.map((study) => <CaseStudyCard study={study} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------------- Hero ---------------- */

  .hero {
    padding-block: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--rule);
  }

  /* The flag input itself: a real checkbox, visually replaced by the .flag
     label's track/thumb, but still in the tab order and announced by name. */
  .flag-input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero__grid {
    display: grid;
    gap: var(--space-3);
    align-items: start;
  }

  .hero__control {
    margin-bottom: var(--space-1);
  }

  @media (min-width: 56rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) 14rem;
      grid-template-areas: "control control" "body figure";
      column-gap: var(--space-5);
      row-gap: var(--space-3);
    }
    .hero__control {
      grid-area: control;
    }
    .hero__figure {
      grid-area: figure;
    }
    .hero__body {
      grid-area: body;
    }
  }

  /* ---------------- The rollout flag ---------------- */

  .flag {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    /* 44px+ touch target on the whole control, not just the visual track. */
    min-height: 2.75rem;
    padding: 0.4rem 0.9rem 0.4rem 0.6rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: var(--paper-raised);
    cursor: pointer;
  }

  .flag__track {
    position: relative;
    width: 2.5rem;
    height: 1.375rem;
    border-radius: 999px;
    background: var(--rule-strong);
    flex: none;
    transition: background-color 0.25s var(--ease-rollout);
  }

  .flag__thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    background: var(--paper-raised);
    box-shadow: var(--shadow-raised);
    transition: transform 0.25s var(--ease-rollout);
  }

  .flag-input:checked ~ .wrap .flag__track {
    background: var(--steel);
  }

  .flag-input:checked ~ .wrap .flag__thumb {
    transform: translateX(1.125rem);
  }

  .flag__text {
    display: grid;
    line-height: 1.35;
    font-family: var(--font-mono);
  }

  .flag__name {
    font-size: var(--step-micro);
    font-weight: 500;
    color: var(--ink);
  }

  .flag__state {
    font-size: 0.75rem;
    color: var(--slate);
  }

  .flag__state--off {
    display: block;
  }

  .flag__state--on {
    display: none;
  }

  .flag-input:checked ~ .wrap .flag__state--on {
    display: block;
  }

  .flag-input:checked ~ .wrap .flag__state--off {
    display: none;
  }

  /* ---------------- Staged outcomes: the orchestrated reveal ---------------- */

  .hero__outcomes-wrap {
    position: relative;
    margin-bottom: var(--space-3);
  }

  .hero__outcomes {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    transition: opacity 0.4s var(--ease-rollout);
  }

  .outcome {
    border-left: 2px solid var(--steel);
    padding-left: 0.85rem;
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.4s var(--ease-rollout), transform 0.4s var(--ease-rollout);
  }

  .outcome:nth-child(2) {
    transition-delay: 0.06s;
  }

  .outcome:nth-child(3) {
    transition-delay: 0.12s;
  }

  .outcome__value {
    display: block;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--steel-dark);
  }

  .outcome__label {
    display: block;
    font-size: var(--step-small);
    color: var(--slate);
    max-width: 46ch;
  }

  .hero__outcomes-off {
    position: absolute;
    inset: 0;
    margin: 0;
    display: flex;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    font-family: var(--font-mono);
    font-size: var(--step-small);
    color: var(--slate-quiet);
    transition: opacity 0.4s var(--ease-rollout);
  }

  .flag-input:not(:checked) ~ .wrap .hero__outcomes {
    opacity: 0;
  }

  .flag-input:not(:checked) ~ .wrap .outcome {
    transform: translateY(6px);
  }

  .flag-input:not(:checked) ~ .wrap .hero__outcomes-off {
    opacity: 1;
  }

  .hero__release {
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    letter-spacing: 0.02em;
    color: var(--slate);
    margin-bottom: var(--space-2);
  }

  .hero__release-tag {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--steel-dark);
    font-weight: 500;
  }

  .hero__figure {
    margin: 0;
    /* On mobile the portrait is centred above the text, not floated beside it. */
    justify-self: center;
    width: min(11rem, 45vw);
  }

  @media (min-width: 56rem) {
    .hero__figure {
      justify-self: end;
      width: 100%;
      max-width: 14rem;
    }
  }

  .hero__photo {
    display: block;
    width: 100%;
    /* height:auto is load-bearing. The img carries width/height attributes (for
       CLS), and aspect-ratio is ignored unless the other axis is auto: without
       this the picture renders 176x640. */
    height: auto;
    /* Square frame. The source is a standing shot: a circle crops to the
       forearms and a 4:5 frame towers over the text column. */
    aspect-ratio: 1 / 1;
    object-fit: cover;
    /* The head sits in the upper third of the 640x640 source. Raise the crop
       to it, but not so far that the top of the head is cut. */
    object-position: 50% 22%;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    box-shadow: var(--shadow-raised);
  }

  .hero__title {
    font-size: var(--step-display);
    max-width: 20ch;
    margin-block: var(--space-2) var(--space-3);
  }

  .hero__lede {
    max-width: 54ch;
    font-size: var(--step-lede);
    color: var(--slate);
    margin-bottom: var(--space-3);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: var(--space-3);
  }

  .hero__location {
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    line-height: 1.6;
    color: var(--slate-quiet);
    max-width: 48ch;
  }

  /* ---------------- Verified results ---------------- */

  .stats {
    padding-block: var(--space-4);
    background: var(--paper-sunk);
    border-bottom: 1px solid var(--rule);
  }

  .stats__heading {
    margin-bottom: var(--space-3);
  }

  .stats__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 40rem) {
    .stats__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3) var(--space-4);
    }
  }

  @media (min-width: 64rem) {
    .stats__list {
      /* The five figures read as one measured ledger, not five loose cards. */
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .stat {
    /* The rule is the signature: each figure is an audited entry, not a badge. */
    border-left: 2px solid var(--steel);
    padding-left: var(--space-2);
    min-width: 0;
  }

  .stat__value {
    font-family: var(--font-mono);
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--steel-dark);
    margin-bottom: 0.4rem;
    overflow-wrap: break-word;
  }

  .stat__label {
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--slate);
    max-width: 40ch;
  }

  /* ---------------- Case studies ---------------- */

  .work {
    padding-block: var(--space-5);
  }

  .work__head {
    margin-bottom: var(--space-4);
  }

  .work__title {
    font-size: var(--step-h2);
    margin-bottom: var(--space-1);
  }

  .work__lede {
    color: var(--slate);
  }

  .work__grid {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 56rem) {
    .work__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

---
/**
 * The home page, rendered once per language.
 *
 * The markup lives here, not in the route files, so `/` and `/es/` cannot drift
 * structurally: there is exactly one template and two thin route wrappers. A
 * section that exists in Spanish but not in English is impossible by
 * construction, and every string comes from a `Localized<T>` object that fails
 * `astro check` if a language is missing.
 */
import Layout from "../../layouts/Layout.astro";
import CaseStudyCard from "../CaseStudyCard.astro";
import { caseStudies } from "../../data/caseStudies";
import { stats } from "../../data/experience";
import { ui } from "../../data/ui";
import { localizedPath, t, type Locale } from "../../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const cvHref =
  lang === "es"
    ? "/marius-mihail-ion-cv-es.pdf"
    : "/marius-mihail-ion-cv.pdf";
---

<Layout
  title={t(ui.homeTitle, lang)}
  description={t(ui.homeDescription, lang)}
  ogTitle={t(ui.homeOgTitle, lang)}
  ogDescription={t(ui.homeOgDescription, lang)}
  includePersonSchema
>
  <section class="hero">
    <div class="wrap hero__grid">
      <figure class="hero__figure sheet parallax-layer" style="--sheet-tilt: 3.4deg">
        <img
          class="hero__photo"
          src="/me.webp"
          alt={t(ui.heroPhotoAlt, lang)}
          width="640"
          height="640"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <div class="hero__body sheet" style="--sheet-tilt: -0.6deg">
        <p class="hero__line-name">Marius Mihail Ion</p>
        <p class="eyebrow">{t(ui.siteRole, lang)}</p>
        <h1 class="hero__title">{t(ui.heroTitle, lang)}</h1>
        <p class="hero__lede">{t(ui.heroLede, lang)}</p>
        <ul class="hero__outcomes">
          {
            stats.slice(0, 3).map((stat, i) => (
              <li
                class="hero__outcome sheet"
                style={`--sheet-tilt: ${(i % 2 === 0 ? 1 : -1) * (1.1 + i * 0.4)}deg`}
              >
                <p class="hero__outcome-value">{t(stat.value, lang)}</p>
                <p class="hero__outcome-label">{t(stat.label, lang)}</p>
              </li>
            ))
          }
        </ul>
        <div class="hero__actions">
          <a class="btn btn-primary" href={localizedPath("/case-studies/", lang)}>
            {t(ui.heroCtaCases, lang)}
          </a>
          <a class="btn" href={cvHref} download>
            {t(ui.heroCtaCv, lang)}
          </a>
          <a class="btn" href="https://linkedin.com/in/mariusdev">LinkedIn</a>
          <a class="btn" href="https://github.com/mihailmariusiondev">GitHub</a>
        </div>
        <p class="hero__location">{t(ui.heroLocation, lang)}</p>
      </div>
    </div>
  </section>

  <div class="torn-edge torn-edge--sunk" aria-hidden="true"></div>
  <section class="stats" aria-labelledby="stats-heading">
    <div class="wrap">
      <h2 id="stats-heading" class="stats__heading eyebrow">
        {t(ui.statsHeading, lang)}
      </h2>
      <ul class="stats__list">
        {
          stats.map((stat) => (
            <li class="stat sheet" style={`--sheet-tilt: ${(Math.random() * 2 - 1).toFixed(2)}deg`}>
              <p class="stat__value">{t(stat.value, lang)}</p>
              <p class="stat__label">{t(stat.label, lang)}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <div class="torn-edge torn-edge--paper" aria-hidden="true"></div>

  <section id="work" class="work">
    <div class="wrap">
      <div class="work__head">
        <h2 class="work__title">{t(ui.workTitle, lang)}</h2>
        <p class="work__lede prose">{t(ui.workLede, lang)}</p>
      </div>
      <div class="work__grid">
        {caseStudies.map((study) => <CaseStudyCard study={study} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------------- Hero ---------------- */

  .hero {
    padding-block: var(--space-5) var(--space-5);
    /* A visible desk surface behind the stacked sheets, not a flat hero band. */
    background: var(--paper-sunk);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .hero__grid {
      /* The photo is a small mounted print pinned over the text sheet's
         corner, not a large second column matching the body's height. */
      grid-template-columns: 1fr;
      position: relative;
    }
  }

  .hero__figure {
    margin: 0 0 0 auto;
    /* On mobile the print sits above the text sheet, tilted. */
    width: min(9rem, 40vw);
    background: var(--paper-raised);
    padding: 0.5rem 0.5rem 0.9rem;
  }

  @media (min-width: 56rem) {
    .hero__figure {
      position: absolute;
      top: -1.5rem;
      right: 2.5rem;
      width: 10rem;
      z-index: 2;
    }
  }

  .hero__photo {
    display: block;
    width: 100%;
    /* height:auto is load-bearing. The img carries width/height attributes (for
       CLS), and aspect-ratio is ignored unless the other axis is auto: without
       this the picture renders 176x640. */
    height: auto;
    /* Square frame. The source is a standing shot: a circle crops to the
       forearms and a 4:5 frame towers over the text column. */
    aspect-ratio: 1 / 1;
    object-fit: cover;
    /* The head sits in the upper third of the 640x640 source. Raise the crop
       to it, but not so far that the top of the head is cut. */
    object-position: 50% 22%;
  }

  .hero__body {
    background: var(--paper-raised);
    padding: var(--space-4) var(--space-4) var(--space-3);
    max-width: 42rem;
  }

  .hero__line-name {
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--slate-quiet);
    margin-bottom: 0.35rem;
  }

  .hero__title {
    font-size: var(--step-display);
    max-width: 20ch;
    margin-block: var(--space-2) var(--space-3);
  }

  .hero__lede {
    max-width: 54ch;
    font-size: var(--step-lede);
    color: var(--slate);
    margin-bottom: var(--space-3);
  }

  .hero__outcomes {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .hero__outcome {
    background: var(--paper-sunk);
    padding: var(--space-2);
    min-width: 0;
  }

  .hero__outcome-value {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--steel-dark);
    margin-bottom: 0.2rem;
    overflow-wrap: break-word;
  }

  .hero__outcome-label {
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--slate);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: var(--space-3);
  }

  .hero__location {
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    line-height: 1.6;
    color: var(--slate-quiet);
    max-width: 48ch;
  }

  /* ---------------- Verified results ---------------- */

  .stats {
    padding-block: var(--space-4);
    background: var(--paper-sunk);
  }

  .stats__heading {
    margin-bottom: var(--space-3);
  }

  .stats__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 40rem) {
    .stats__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3) var(--space-4);
    }
  }

  @media (min-width: 64rem) {
    .stats__list {
      /* The five figures read as one measured ledger, not five loose cards. */
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .stat {
    /* Each figure sits as its own stacked note card, not a bare rule. */
    border-left: 2px solid var(--steel);
    padding: var(--space-2);
    background: var(--paper-raised);
    border-radius: var(--radius);
    min-width: 0;
  }

  .stat__value {
    font-family: var(--font-mono);
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--steel-dark);
    margin-bottom: 0.4rem;
    overflow-wrap: break-word;
  }

  .stat__label {
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--slate);
    max-width: 40ch;
  }

  /* ---------------- Case studies ---------------- */

  .work {
    padding-block: var(--space-5);
  }

  .work__head {
    margin-bottom: var(--space-4);
  }

  .work__title {
    font-size: var(--step-h2);
    margin-bottom: var(--space-1);
  }

  .work__lede {
    color: var(--slate);
  }

  .work__grid {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 56rem) {
    .work__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

---
/**
 * The hero's "wow in 3 seconds" moment: seven star tiles, generated by the
 * same `mudejar.ts` function as everything else on the site, that assemble
 * from a scatter into a locked lazería cluster behind the name/role. Pure
 * CSS keyframes, no JS, `animation-fill-mode: both` so the end state is the
 * resting state — a no-motion browser or a reduced-motion visitor simply
 * sees the finished cluster (the base site's global
 * `prefers-reduced-motion` rule already collapses the animation duration to
 * ~0, so no separate override is needed here).
 */
import { spikesForIndex, starSvgPoints, toneForIndex } from "../lib/mudejar";

/* Positioned to sit in the gutters and open corners of the hero, never
   crossing the text column (eyebrow/title/lede/buttons run roughly
   x 12%-64%, y 8%-92%) so the assembled cluster frames the copy instead of
   sitting on top of it. */
const TILES = [
  { top: "3%", left: "4%", size: 60, dx: -70, dy: -50, dr: -70, delay: 0 },
  { top: "1%", left: "68%", size: 40, dx: 40, dy: -80, dr: 60, delay: 60 },
  { top: "66%", left: "6%", size: 34, dx: -90, dy: 30, dr: -90, delay: 120 },
  { top: "84%", left: "62%", size: 30, dx: 30, dy: 60, dr: 80, delay: 90 },
  { top: "2%", left: "92%", size: 26, dx: 90, dy: -40, dr: -60, delay: 180 },
  { top: "40%", left: "96%", size: 30, dx: 60, dy: 40, dr: 70, delay: 150 },
  { top: "86%", left: "3%", size: 24, dx: -60, dy: 40, dr: 90, delay: 210 },
] as const;
---

<div class="hero-cluster" aria-hidden="true">
  {
    TILES.map((tile, i) => {
      const spikes = spikesForIndex(i);
      const tone = toneForIndex(i);
      const points = starSvgPoints(tile.size, { spikes, rotation: i * 7 });
      return (
        <svg
          class={`hero-cluster__tile hero-cluster__tile--${tone}`}
          style={`top:${tile.top}; left:${tile.left}; width:${tile.size}px; height:${tile.size}px; --dx:${tile.dx}px; --dy:${tile.dy}px; --dr:${tile.dr}deg; animation-delay:${tile.delay}ms;`}
          viewBox={`0 0 ${tile.size} ${tile.size}`}
          focusable="false"
        >
          <polygon points={points} />
        </svg>
      );
    })
  }
</div>

<style>
  .hero-cluster {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-cluster__tile {
    position: absolute;
    animation: assemble 900ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .hero-cluster__tile polygon {
    fill: color-mix(in srgb, currentColor 14%, transparent);
    stroke: currentColor;
    stroke-width: 1.25;
  }

  .hero-cluster__tile--cobalt {
    color: var(--cobalt);
  }
  .hero-cluster__tile--green {
    color: var(--green);
  }
  .hero-cluster__tile--ochre {
    color: var(--ochre);
  }

  @keyframes assemble {
    from {
      opacity: 0;
      transform: translate(var(--dx), var(--dy)) rotate(var(--dr)) scale(0.5);
    }
    to {
      opacity: 1;
      transform: translate(0, 0) rotate(0deg) scale(1);
    }
  }

  @media (max-width: 47.999rem) {
    /* On phones the cluster would sit under running text; keep it, but
       thinned and confined to the top band so it reads as texture, not
       noise, above the fold. */
    .hero-cluster {
      opacity: 0.7;
    }
  }
</style>

---
/**
 * The background lattice: a repeating SVG pattern of the same star generator,
 * used as a quiet structural wash behind the hero and section dividers. It is
 * decorative (aria-hidden) and purely CSS-color-driven via `currentColor`, so
 * it follows the surrounding tone and light/dark theme automatically.
 */
import { starSvgPoints } from "../lib/mudejar";

interface Props {
  /** Unique id for this instance's <pattern>, so multiple lattices on one page never collide. */
  id: string;
  /** Repeat tile size in px (the pattern's own coordinate space). */
  size?: number;
  opacity?: number;
  class?: string;
}

const { id, size = 56, opacity = 0.08, class: className } = Astro.props;
const points = starSvgPoints(size * 0.62, { spikes: 8 });
const offset = (size - size * 0.62) / 2;
---

<svg
  class:list={["tile-lattice", className]}
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid slice"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <pattern
      id={id}
      width={size}
      height={size}
      patternUnits="userSpaceOnUse"
      patternTransform="rotate(0)"
    >
      <polygon
        points={points}
        transform={`translate(${offset} ${offset})`}
        fill="none"
        stroke="currentColor"
        stroke-width="1"
      />
      <polygon
        points={points}
        transform={`translate(${offset + size / 2} ${offset + size / 2})`}
        fill="none"
        stroke="currentColor"
        stroke-width="1"
      />
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} style={`opacity:${opacity}`} />
</svg>

<style>
  .tile-lattice {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--ink);
    pointer-events: none;
  }
</style>

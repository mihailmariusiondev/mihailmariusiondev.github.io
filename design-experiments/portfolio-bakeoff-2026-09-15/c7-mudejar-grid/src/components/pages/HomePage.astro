---
/**
 * The home page, rendered once per language.
 *
 * The markup lives here, not in the route files, so `/` and `/es/` cannot drift
 * structurally: there is exactly one template and two thin route wrappers. A
 * section that exists in Spanish but not in English is impossible by
 * construction, and every string comes from a `Localized<T>` object that fails
 * `astro check` if a language is missing.
 */
import Layout from "../../layouts/Layout.astro";
import CaseStudyCard from "../CaseStudyCard.astro";
import HeroCluster from "../HeroCluster.astro";
import TileLattice from "../TileLattice.astro";
import TileChip from "../TileChip.astro";
import { caseStudies } from "../../data/caseStudies";
import { stats } from "../../data/experience";
import { ui } from "../../data/ui";
import { starClipPath } from "../../lib/mudejar";
import { localizedPath, t, type Locale } from "../../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const cvHref =
  lang === "es"
    ? "/marius-mihail-ion-cv-es.pdf"
    : "/marius-mihail-ion-cv.pdf";
const photoClip = starClipPath({ spikes: 8 });
---

<Layout
  title={t(ui.homeTitle, lang)}
  description={t(ui.homeDescription, lang)}
  ogTitle={t(ui.homeOgTitle, lang)}
  ogDescription={t(ui.homeOgDescription, lang)}
  includePersonSchema
>
  <section class="hero">
    <TileLattice id="hero-lattice" class="hero__lattice" opacity={0.07} />
    <HeroCluster />
    <div class="wrap hero__grid">
      <figure class="hero__figure">
        <div class="hero__frame" style={`clip-path:${photoClip}`}>
          <img
            class="hero__photo"
            src="/me.webp"
            alt={t(ui.heroPhotoAlt, lang)}
            width="640"
            height="640"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </figure>

      <div class="hero__body">
        <p class="eyebrow">{t(ui.siteRole, lang)}</p>
        <h1 class="hero__title">{t(ui.heroTitle, lang)}</h1>
        <p class="hero__lede">{t(ui.heroLede, lang)}</p>
        <div class="hero__actions">
          <a class="btn btn-primary" href={localizedPath("/case-studies/", lang)}>
            {t(ui.heroCtaCases, lang)}
          </a>
          <a class="btn" href={cvHref} download>
            {t(ui.heroCtaCv, lang)}
          </a>
          <a class="btn" href="https://linkedin.com/in/mariusdev">LinkedIn</a>
          <a class="btn" href="https://github.com/mihailmariusiondev">GitHub</a>
        </div>
        <p class="hero__location">{t(ui.heroLocation, lang)}</p>
      </div>
    </div>
  </section>

  <div class="lattice-divider" role="presentation"></div>

  <section class="stats" aria-labelledby="stats-heading">
    <div class="wrap">
      <h2 id="stats-heading" class="stats__heading eyebrow">
        {t(ui.statsHeading, lang)}
      </h2>
      <ul class="stats__list">
        {
          stats.map((stat, i) => (
            <li class="stat">
              <TileChip index={i} size={22} class="stat__chip" />
              <p class="stat__value">{t(stat.value, lang)}</p>
              <p class="stat__label">{t(stat.label, lang)}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="work" class="work">
    <div class="wrap">
      <div class="work__head">
        <h2 class="work__title">{t(ui.workTitle, lang)}</h2>
        <p class="work__lede prose">{t(ui.workLede, lang)}</p>
      </div>
      <div class="work__grid">
        {caseStudies.map((study, i) => <CaseStudyCard study={study} index={i} />)}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------------- Hero ---------------- */

  .hero {
    position: relative;
    padding-block: var(--space-4) var(--space-5);
    overflow: hidden;
  }

  :global(.hero__lattice) {
    z-index: 0;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .hero__grid {
      /* Text first in the source order and in the visual order on desktop. */
      grid-template-columns: minmax(0, 1fr) 14rem;
      gap: var(--space-5);
    }
    .hero__figure {
      order: 2;
    }
    .hero__body {
      order: 1;
    }
  }

  .hero__figure {
    margin: 0;
    /* On mobile the portrait is centred above the text, not floated beside it. */
    justify-self: center;
    width: min(11rem, 45vw);
  }

  @media (min-width: 56rem) {
    .hero__figure {
      justify-self: end;
      width: 100%;
      max-width: 14rem;
    }
  }

  /* The star clip-path is applied to this wrapper (not the <img>): a
     clipped raster edge needs a solid backing so the star's points read
     crisply against the lattice behind it, and the padding gives the frame
     a visible "tile" rim in the accent color. */
  .hero__frame {
    padding: 0.55rem;
    background: linear-gradient(
      145deg,
      var(--cobalt) 0%,
      var(--green) 55%,
      var(--ochre) 100%
    );
    box-shadow: var(--shadow-raised);
  }

  .hero__photo {
    display: block;
    width: 100%;
    /* height:auto is load-bearing. The img carries width/height attributes (for
       CLS), and aspect-ratio is ignored unless the other axis is auto: without
       this the picture renders 176x640. */
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    /* The head sits in the upper third of the 640x640 source. Raise the crop
       to it, but not so far that the top of the head is cut. */
    object-position: 50% 22%;
    background: var(--paper-raised);
    /* Slightly over-clip the same star, inset, so the accent frame shows as
       an even rim rather than doubling the silhouette exactly. */
    clip-path: inherit;
    transform: scale(0.94);
  }

  .hero__title {
    font-size: var(--step-display);
    max-width: 20ch;
    margin-block: var(--space-2) var(--space-3);
  }

  .hero__lede {
    max-width: 54ch;
    font-size: var(--step-lede);
    color: var(--slate);
    margin-bottom: var(--space-3);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: var(--space-3);
  }

  .hero__location {
    font-family: var(--font-mono);
    font-size: var(--step-micro);
    line-height: 1.6;
    color: var(--slate-quiet);
    max-width: 48ch;
  }

  /* ---------------- Verified results ---------------- */

  .stats {
    padding-block: var(--space-4);
    background: var(--paper-sunk);
    border-bottom: 1px solid var(--rule);
  }

  .stats__heading {
    margin-bottom: var(--space-3);
  }

  .stats__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 40rem) {
    .stats__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3) var(--space-4);
    }
  }

  @media (min-width: 64rem) {
    .stats__list {
      /* The five figures read as one measured ledger, not five loose cards. */
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .stat {
    min-width: 0;
  }

  :global(.stat__chip) {
    margin-bottom: 0.5rem;
  }

  .stat__value {
    font-family: var(--font-mono);
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--cobalt-dark);
    margin-bottom: 0.4rem;
    overflow-wrap: break-word;
  }

  .stat__label {
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--slate);
    max-width: 40ch;
  }

  /* ---------------- Case studies ---------------- */

  .work {
    padding-block: var(--space-5);
  }

  .work__head {
    margin-bottom: var(--space-4);
  }

  .work__title {
    font-size: var(--step-h2);
    margin-bottom: var(--space-1);
  }

  .work__lede {
    color: var(--slate);
  }

  .work__grid {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 56rem) {
    .work__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
